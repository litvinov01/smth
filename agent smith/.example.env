# Required — OpenAI key used for both the LLM and embeddings
OPENAI_API_KEY=

# Optional overrides (defaults shown)
#AGENT_SMITH_LLM_MODEL=gpt-4o-mini
#AGENT_SMITH_EMBEDDING_MODEL=text-embedding-3-small
#AGENT_SMITH_SIMILARITY_TOP_K=5

# Rate-limit tuning: worst case tokens per embedding request ~= batch * chunk size.
# Defaults (10 * 512 = ~5k tokens/request) fit the free 40k TPM tier.
#AGENT_SMITH_EMBED_BATCH_SIZE=10
#AGENT_SMITH_CHUNK_SIZE=512

# Comma-separated paths (relative to the repo root) to index.
#AGENT_SMITH_SOURCES=.meta,README.md,docker-compose.yml,Makefile,contracts,orchestrator/README.md,orchestrator/prisma,orchestrator/src

# Where the persisted vector index lives (default: "agent smith/.storage")
#AGENT_SMITH_STORAGE_DIR=

# Index a different checkout (default: the repo this folder lives in)
#AGENT_SMITH_REPO_ROOT=
