# App
NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/swap_db?schema=public"

# Messaging (Kafka) — event-driven chain orchestration
PROCESS_ROLE=all
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=swap-orchestrator
RECEIPT_CHECK_DELAY_MS=3000
SETTLEMENT_CHECK_DELAY_MS=5000
SETTLEMENT_CHECK_MAX_ATTEMPTS=120
KAFKA_CONSUMER_MAX_RETRIES=3
DEPLOYMENT_CLAIM_TTL_MS=300000

# EVM / smart contracts (optional — workers skip chain checks when unset)
EVM_RPC_URL="http://localhost:8545"
EVM_CHAIN_ID=31337
ORCHESTRATOR_PRIVATE_KEY="0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"
TRANSACTOR_BYTECODE=""
