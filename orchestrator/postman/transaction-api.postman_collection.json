                                    "    pm.response.to.have.status(400);",
                                    "});",
                                    "",
                                    "pm.test('Error mentions status transition', function () {",
                                    "    const payload = JSON.stringify(pm.response.json()).toLowerCase();",
                                    "    pm.expect(payload).to.match(/cannot be submitted|status/);",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [],
                        "url": "{{baseUrl}}/api/v1/transactions/{{transactionWithConsumerId}}/submit"
