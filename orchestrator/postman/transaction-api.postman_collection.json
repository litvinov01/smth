{
    "info": {
        "_postman_id": "a3f8c2e1-9b4d-4f6a-8c1e-2d5f7a9b3c4e",
        "name": "Swap Orchestrator - Transaction API",
        "description": "Postman collection for `/api/v1/transactions` endpoints.\n\n**Setup:** Import this collection and ensure the orchestrator is running (`make up` or `npm run start:dev`).\n\n**Variables:** `baseUrl`, `userId`, and `consumerAddress` are preconfigured. Successful create requests store `transactionId` / `transactionWithConsumerId` for downstream requests.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:3000"
        },
        {
            "key": "userId",
            "value": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        },
        {
            "key": "consumerAddress",
            "value": "0x70997970c51812dc3a010c7d01b50e0d17dc79c8"
        },
        {
            "key": "transactionId",
            "value": ""
        },
        {
            "key": "transactionWithConsumerId",
            "value": ""
        },
        {
            "key": "unknownTransactionId",
            "value": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
        }
    ],
    "item": [
        {
            "name": "Happy Path Flow",
            "description": "Sequential flow: create → get. Run this folder with the Collection Runner.",
            "item": [
                {
                    "name": "1. Create Transaction",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status is 201 Created', function () {",
                                    "    pm.response.to.have.status(201);",
                                    "});",
                                    "",
                                    "pm.test('Content-Type is JSON', function () {",
                                    "    pm.response.to.have.header('Content-Type', /json/);",
                                    "});",
                                    "",
                                    "const body = pm.response.json();",
                                    "",
                                    "pm.test('Transaction shape is valid', function () {",
                                    "    pm.expect(body.id).to.match(/^[a-f0-9]{32}$/);",
                                    "    pm.expect(body.currency).to.eql('EUR');",
                                    "    pm.expect(body.status).to.eql('CREATED');",
                                    "    pm.expect(body.amount).to.eql('100.5');",
                                    "    pm.expect(body.user.id).to.eql(pm.collectionVariables.get('userId'));",
                                    "    pm.expect(body.created_at).to.be.a('string');",
                                    "    pm.expect(body.consumer_address).to.be.null;",
                                    "    pm.expect(body.contract_address).to.be.null;",
                                    "    pm.expect(body.tx_hash).to.be.null;",
                                    "});",
                                    "",
                                    "pm.collectionVariables.set('transactionId', body.id);"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"currency\": \"eur\",\n  \"amount\": \"100.50\",\n  \"user\": {\n    \"id\": \"{{userId}}\"\n  }\n}"
                        },
                        "url": "{{baseUrl}}/api/v1/transactions"
                    }
                },
                {
                    "name": "2. Get Transaction by ID",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status is 200 OK', function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "const body = pm.response.json();",
                                    "const expectedId = pm.collectionVariables.get('transactionId');",
                                    "",
                                    "pm.test('Returns the created transaction', function () {",
                                    "    pm.expect(expectedId, 'Run \"1. Create Transaction\" first').to.not.be.empty;",
                                    "    pm.expect(body.id).to.eql(expectedId);",
                                    "    pm.expect(body.currency).to.eql('EUR');",
                                    "    pm.expect(body.status).to.eql('CREATED');",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": "{{baseUrl}}/api/v1/transactions/{{transactionId}}"
                    }
                },
                {
                    "name": "3. Create Transaction with Consumer",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status is 201 Created', function () {",
                                    "    pm.response.to.have.status(201);",
                                    "});",
                                    "",
                                    "const body = pm.response.json();",
                                    "",
                                    "pm.test('Consumer address is persisted', function () {",
                                    "    pm.expect(body.id).to.match(/^[a-f0-9]{32}$/);",
                                    "    pm.expect(body.consumer_address).to.eql(pm.collectionVariables.get('consumerAddress').toLowerCase());",
                                    "    pm.expect(body.status).to.eql('CREATED');",
                                    "});",
                                    "",
                                    "pm.collectionVariables.set('transactionWithConsumerId', body.id);"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"currency\": \"USD\",\n  \"amount\": \"250\",\n  \"user\": {\n    \"id\": \"{{userId}}\"\n  },\n  \"consumer\": {\n    \"address\": \"{{consumerAddress}}\"\n  }\n}"
                        },
                        "url": "{{baseUrl}}/api/v1/transactions"
                    }
                }
            ]
        },
