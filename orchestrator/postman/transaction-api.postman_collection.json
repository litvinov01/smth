        {
            "name": "Get Transaction",
            "item": [
                {
                    "name": "Get - By ID (uses transactionId variable)",
                    "event": [
                        {
                            "listen": "prerequest",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "if (!pm.collectionVariables.get('transactionId')) {",
                                    "    throw new Error('transactionId is empty. Run \"Happy Path Flow > 1. Create Transaction\" first or set transactionId manually.');",
                                    "}"
                                ]
                            }
                        },
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status is 200 OK', function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "pm.test('Response matches transactionId variable', function () {",
                                    "    pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('transactionId'));",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": "{{baseUrl}}/api/v1/transactions/{{transactionId}}"
                    }
                },
