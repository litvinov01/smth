                    "name": "Get - Not found",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status is 404 Not Found', function () {",
                                    "    pm.response.to.have.status(404);",
                                    "});",
                                    "",
                                    "pm.test('Error message references transaction id', function () {",
                                    "    const payload = JSON.stringify(pm.response.json()).toLowerCase();",
                                    "    pm.expect(payload).to.include('not found');",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": "{{baseUrl}}/api/v1/transactions/{{unknownTransactionId}}"
