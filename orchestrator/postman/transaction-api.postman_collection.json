                },
                {
                    "name": "Submit - Valid (requires EVM)",
                    "event": [
                        {
                            "listen": "prerequest",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "if (!pm.collectionVariables.get('transactionWithConsumerId')) {",
                                    "    throw new Error('transactionWithConsumerId is empty. Run \"Happy Path Flow > 3. Create Transaction with Consumer\" first.');",
                                    "}"
                                ]
                            }
                        },
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status is 200 OK or 503 when EVM is unavailable', function () {",
                                    "    pm.expect(pm.response.code).to.be.oneOf([200, 503]);",
                                    "});",
                                    "",
                                    "if (pm.response.code === 200) {",
                                    "    const body = pm.response.json();",
                                    "    pm.test('Transaction moves to PENDING with tx_hash', function () {",
                                    "        pm.expect(body.status).to.eql('PENDING');",
                                    "        pm.expect(body.tx_hash).to.match(/^0x[a-f0-9]{64}$/);",
                                    "    });",
                                    "}",
                                    "",
                                    "if (pm.response.code === 503) {",
                                    "    pm.test('Service unavailable when EVM is not configured', function () {",
                                    "        const payload = JSON.stringify(pm.response.json()).toLowerCase();",
                                    "        pm.expect(payload).to.match(/unavailable|deploy/);",
                                    "    });",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [],
                        "url": "{{baseUrl}}/api/v1/transactions/{{transactionWithConsumerId}}/submit"
                    }
