# PostgreSQL (used by docker compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=swap_db
POSTGRES_PORT=5432

# Orchestrator HTTP port (host mapping)
ORCHESTRATOR_PORT=3000

# Redpanda / Kafka (host mapping)
KAFKA_PORT=9092

# Shared Docker network (compose + integration tests)
DOCKER_NETWORK=swap-net

# Agent Smith (only needed for `make agent-docker` / compose profile "agent")
OPENAI_API_KEY=
